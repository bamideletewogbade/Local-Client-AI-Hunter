# ─── Clerk — auth & user management ───
# Client-side publishable key for Clerk app app_3EUAWSh5nvyas2eeOIvBaS32GbE.
# This is NON-secret (safe to expose in the browser). Get it from
# https://dashboard.clerk.com/~/api-keys → choose "React".
# Without it the app still boots (anonymous mode) and the header shows "AUTH: SET KEY".
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
# SERVER-SIDE secret — verifies the Clerk session on /api/* and scopes each user's
# pipeline to their account. KEEP SECRET (never commit a real value; never expose
# to the client). Without it the server runs in shared "public" mode (no isolation).
CLERK_SECRET_KEY="sk_test_replace_me"

# ─── AI providers (server-side) ───
OPENROUTER_API_KEY=""   # primary LLM gateway (OpenRouter)
GROQ_API_KEY=""         # fallback LLM + Whisper voice transcription

# ─── Real lead data (optional) ───
# Google Places API (New) key. When set, Discovery returns REAL businesses from
# Google Maps; otherwise it falls back to AI-generated / synthetic sample leads.
GOOGLE_PLACES_API_KEY=""

# ─── WhatsApp outreach (optional — Meta Cloud API) ───
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="hunter_wacrm_verify"
